# AI Provider Configuration
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Voice STT Configuration
STT_PROVIDER=faster-whisper
STT_MODEL=large-v3-turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_TASK=transcribe
STT_BEAM_SIZE=5
STT_TEMPERATURE=0.0
STT_CONDITION_ON_PREVIOUS_TEXT=false
STT_WITHOUT_TIMESTAMPS=true
STT_VAD_FILTER=true
STT_VAD_MIN_SILENCE_DURATION_MS=500
STT_HOTWORDS=Helium, Firefox, Chrome, Kitty, Hyprland, NVIDIA, NetworkManager, ElectroBOOM, Airi

# Voice TTS Configuration
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_DEVICE=cpu
SAVE_DIAGNOSTIC_AUDIO=false
DIAGNOSTIC_AUDIO_DIR=data/diagnostics/audio

# Wakeword Configuration
WAKEWORD_ENABLED=false
WAKEWORD_MODEL=hey_airi

# Avatar / UI Configuration
AVATAR_ENABLED=true
AVATAR_ALWAYS_ON_TOP=true
AVATAR_OPACITY=0.95

# Logging and Database
LOG_LEVEL=INFO
MEMORY_DB_PATH=data/memory.db

# Screen/Browser
BROWSER_TYPE=firefox
SCREENSHOT_MONITOR=0

# Security
PERMISSION_DEFAULT=CONFIRM
